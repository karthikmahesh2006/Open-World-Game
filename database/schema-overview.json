      "model": "Mission",
      "fields": [
        "missionId",
        "title",
        "description",
        "category",
        "statKey",
        "targetValue",
        "rewardXp",
        "rewardCoins"
      ]
    },
    {
      "name": "leaderboardentries",
      "model": "LeaderboardEntry",
      "fields": [
        "player",
        "username",
        "category",
        "score",
        "recordedAt"
      ]
    }
  ]
