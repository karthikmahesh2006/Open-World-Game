{
  "database": "blocky_metro_game",
  "collections": [
    {
      "name": "players",
      "model": "Player",
      "fields": [
        "username",
        "email",
        "passwordHash",
        "avatarConfig",
        "settings",
        "lastKnownPosition"
      ]
    },
    {
      "name": "gameprogresses",
      "model": "GameProgress",
